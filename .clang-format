# -*- coding: utf-8 -*-

# The predefined formatting style used as the base for these settings.
BasedOnStyle: Google

# The number of columns used for tab stops.
TabWidth: 4

# The number of columns to use for indentation.
IndentWidth: 4

# Preserve manual line breaks instead of wrapping at a fixed width.
ColumnLimit: 0

# The way to use tab characters in the resulting file.
UseTab: Never

# Pointer and reference alignment style.
PointerAlignment: Left

# Align access modifiers with the class declaration.
AccessModifierOffset: -4

# Keep empty test fixtures on multiple lines.
AllowShortRecordOnASingleLine: Never

# Keep empty functions on a single line.
AllowShortFunctionsOnASingleLine: Empty

# Ensure the file ends with a newline.
InsertNewlineAtEOF: true

# Do not indent namespace contents.
NamespaceIndentation: None

# Leave namespace closing comments unchanged.
FixNamespaceComments: false
