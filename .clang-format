# -*- coding: utf-8 -*-

# Created by: Vladislav Punko <iam.vlad.punko@gmail.com>
# Created date: 2026-10-21

BasedOnStyle: Google
# Keep empty test fixtures on multiple lines.
AllowShortRecordOnASingleLine: Never
# Separate C headers, C++ headers, GoogleTest and project headers.
IncludeCategories:
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<'
    Priority: 2
  - Regex: '^"gtest/'
    Priority: 3
  - Regex: '.*'
    Priority: 4
