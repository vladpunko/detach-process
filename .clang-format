# -*- coding: utf-8 -*-

# The predefined formatting style used as the base for these settings.
BasedOnStyle: Google

# The number of columns used for tab stops.
TabWidth: 4

# The number of columns to use for indentation.
IndentWidth: 4

# The way to use tab characters in the resulting file.
UseTab: Never

# Pointer and reference alignment style.
PointerAlignment: Left

# The extra indent or outdent of access modifiers.
AccessModifierOffset: 0

# Keep empty test fixtures on multiple lines.
AllowShortRecordOnASingleLine: Never

# Keep function definitions on multiple lines, including empty functions.
AllowShortFunctionsOnASingleLine: None

# Ensure the file ends with a newline.
InsertNewlineAtEOF: true

# Indent the contents of all namespaces, including nested namespaces.
NamespaceIndentation: All

# Leave namespace closing comments unchanged.
FixNamespaceComments: false
